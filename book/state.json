    "promises": {
      "P01": {
        "history": [
          {
            "id": "P01",
            "action": "set",
            "deadline_chapter": 3,
            "reason": "本章只看了疵样和一口缸，未解答全批成因；按第3章实际分组兑现，不因之后的普通推进延期。",
            "evidence": {
              "chapter": 1,
              "sha256": "6d60b8c3f0db7365712f32f3206996cfecb14f2b512c411d900c67f965bd29d0",
              "quote": "“我只能说，还得把各捆分开看。”她把布还回去，“不能拿这一角，就说全是同一种毛病。”"
            },
            "chapter": 1
          },
          {
            "id": "P01",
            "action": "complete",
            "deadline_chapter": 3,
            "reason": "逐匹和分样给40可继续试、24须重理不进交期、8布身不可复原级答案；P02另约未来40合格交付，不把范围完成当产成品完成。",
            "evidence": {
              "chapter": 3,
              "sha256": "c81a946479ad852b4ed4b0caf5135636de5b1caca772c05f1cc5fcfac5c128d9",
              "quote": "这八匹，我救不回原来那个品级。"
            },
            "chapter": 3
          }
        ],
        "deadline_chapter": 3,
        "status": "closed",
        "last_reviewed_chapter": 3
      },
      "P04": {
        "history": [
          {
            "id": "P04",
            "action": "set",
            "deadline_chapter": 16,
            "reason": "旧欠仅由周家认账，尚无金额实核或付款；规划第13章首款、第16章结清，但须到时凭实际正文，不用保证替代。",
            "evidence": {
              "chapter": 1,
              "sha256": "6d60b8c3f0db7365712f32f3206996cfecb14f2b512c411d900c67f965bd29d0",
              "quote": "他已将旧债认在纸上，至于什么时候真付到各人手里，还得一笔一笔去问。"
            },
            "chapter": 1
          }
        ],
        "deadline_chapter": 16,
        "status": "open",
        "last_reviewed_chapter": 6
      },
      "P13": {
        "history": [
          {
            "id": "P13",
            "action": "set",
            "deadline_chapter": 3,
            "reason": "明早点存货、保全客料与谈活的安排已明确。第2章仍从当日午后开始，第3章到次晨，届时实际完成，不能提前开封或拖过约定日期。",
            "evidence": {
              "chapter": 1,
              "sha256": "6d60b8c3f0db7365712f32f3206996cfecb14f2b512c411d900c67f965bd29d0",
              "quote": "“厂屋、晒场和今日点交的缸具，从此归陆姑娘管。明早再点存货，没点清以前，两边都不许挪。”"
            },
            "chapter": 1
          },
          {
            "id": "P13",
            "action": "complete",
            "deadline_chapter": 3,
            "reason": "初九双方看封开门点64/72、先谈工再做、陶半日真实领款，程授权亦先展示；原次晨承诺实落地。",
            "evidence": {
              "chapter": 3,
              "sha256": "c81a946479ad852b4ed4b0caf5135636de5b1caca772c05f1cc5fcfac5c128d9",
              "quote": "两人先看纸封与门锁，核过昨夜留下的记号，才分别开了自有布库与验布间。"
            },
            "chapter": 3
          }
        ],
        "deadline_chapter": 3,
        "status": "closed",
        "last_reviewed_chapter": 3
      },
      "P14": {
        "history": [
          {
            "id": "P14",
            "action": "set",
            "deadline_chapter": 3,
            "reason": "本章首次明确丁茂生次晨带逐人副册供核；下一章应见副册到手及范围，副册不等于付款，不能并入第16章拖延。",
            "evidence": {
              "chapter": 2,
              "sha256": "e009c694af91c54ed6abeba96f48da71720db356300bc0a080a5dd90d562c4f9",
              "quote": "明日把逐人欠项的副册带来，愿留在坊里的可以看，原册仍归周记备核。"
            },
            "chapter": 2
          },
          {
            "id": "P14",
            "action": "complete",
            "deadline_chapter": 3,
            "reason": "丁交经署名逐人副册，陶核自己和离坊杨栓页，陆收堂屋供查，非借下一张纸拖延或代付款。",
            "evidence": {
              "chapter": 3,
              "sha256": "c81a946479ad852b4ed4b0caf5135636de5b1caca772c05f1cc5fcfac5c128d9",
              "quote": "副册用新纸抄的，边上还夹着昨夜未核的几张旧凭。"
            },
            "chapter": 3
          }
        ],
        "deadline_chapter": 3,
        "status": "closed",
        "last_reviewed_chapter": 3
      },
      "P02": {
        "history": [
          {
            "id": "P02",
            "action": "set",
            "deadline_chapter": 10,
            "reason": "首次有限40匹、300文每合格匹和初十五验收后费；阶段末须实交实收且承认成本，不用装船或签约代替。",
            "evidence": {
              "chapter": 3,
              "sha256": "c81a946479ad852b4ed4b0caf5135636de5b1caca772c05f1cc5fcfac5c128d9",
              "quote": "每匹合格后收三百文，四十匹共十二两。"
            },
            "chapter": 3
          }
        ],
        "deadline_chapter": 10,
        "status": "open",
        "last_reviewed_chapter": 6
      },
      "P03": {
        "history": [
          {
            "id": "P03",
            "action": "set",
            "deadline_chapter": 12,
            "reason": "余32匹连样明确仍属客方，十八日为第10故事日，依第11—12章返程与客方取法落实；不得改自有货或只取得回信。",
            "evidence": {
              "chapter": 3,
              "sha256": "c81a946479ad852b4ed4b0caf5135636de5b1caca772c05f1cc5fcfac5c128d9",
